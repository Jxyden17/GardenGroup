@model List<GardenGroup.Models.Ticket>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Opened</th>
            <th>Deadline</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int nr = 1;
        
        foreach (Ticket ticket in Model)
        {
            <tr>
                <td>@nr</td>
                <td>@ticket.Title</td>
                <td>@ticket.Prioriteit</td>
                <td>@ticket.Status</td>
                <td>@(ticket.Datum_open?.ToString("dd-MM-yyyy"))</td>
                <td>@(ticket.Deadline?.ToString("dd-MM-yyyy"))</td>
                <td>
                        <a class="btn btn-sm btn-info" asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id">Details</a> |
                        <a class="btn btn-sm btn-warning" asp-controller="Ticket" asp-action="Update" asp-route-id="@ticket.Id">Edit</a> |
                        <a class="btn btn-sm btn-danger" asp-controller="Ticket" asp-action="Delete" asp-route-id="@ticket.Id">Delete</a> |
                        <a class="btn btn-sm btn-info" asp-controller="Ticket" asp-action="Transfer" asp-route-id="@ticket.Id">Transfer</a>
                </td>
            </tr>
            nr++;
        }
        }
    </tbody>
</table>