@model GardenGroup.Models.Ticket
@{
    ViewData["Title"] = "Transfer Ticket";
    var users = ViewBag.Users as List<GardenGroup.Models.ApplicationUser>;
}

<h2>Transfer Ticket: @Model.Title</h2>

<form asp-action="Transfer" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <label for="newSolverUserId">Select user</label>
    <select id="newSolverUserId" name="newSolverUserId" class="form-select" required>
        <option value="">-- choose ServiceDesk user by email--</option>
        @foreach (var u in users)
        {
            <option value="@u.Id">@u.Email</option>
        }
    </select>
    <div>
    <button type="submit" class="btn btn-primary mt-3">Transfer</button>
        <a asp-controller="User" asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Cancel</a>
    </div>
</form>