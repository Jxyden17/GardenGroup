@model Ticket
@using GardenGroup.Enums

@{
    ViewData["Title"] = "Edit Ticket";
}

<h1>@ViewData["Title"]</h1>

<partial name="_ErrorMessage" />

<form asp-controller="Ticket" asp-action="Update" method="post">
    <input type="hidden" name="Id" value="@Model?.Id" />

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" id="title" name="Title" class="form-control" required value="@Model?.Title" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block fw-bold mb-2">Type</label>
       @foreach(TicketTypes types in Enum.GetValues(typeof(TicketTypes)))
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                type="radio"
                name="Type"
                id="Type(@types)"
                value="@types"
                @(Model != null && Model.Type == types ? "checked" : "") />
                <label class="form-check-label" for="type(@types)">@types</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label d-block fw-bold mb-2">Priority</label>
        @foreach (TicketPrioriteiten level in Enum.GetValues(typeof(TicketPrioriteiten)))
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" 
                type="radio" 
                name="Priority" 
                id="priority(@level)" 
                value="@level" 
                @(Model != null && Model.Prioriteit == level ? "checked" : "") />
                <label class="form-check-label" for="priority(@level)">@level</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label d-block fw-bold mb-2">Status</label>
       @foreach(TicketStatuses statuses in Enum.GetValues(typeof(TicketStatuses)))
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="radio"
                       name="status"
                       id="status(@statuses)"
                       value="@statuses"
                       @(Model != null && Model.Status == statuses ? "checked" : "") />
                <label class="form-check-label" for="status(@statuses)">@statuses</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="Description" class="form-control" rows="4" required>@Model?.Description</textarea>
    </div>

    <div class="mb-3">
        <label for="datumOpen" class="form-label">Date Opened</label>
        <input type="datetime-local" id="datumOpen" name="Datum_open" class="form-control" value="@(Model?.Datum_open?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
    </div>

    <div class="mb-3">
        <label for="datumClose" class="form-label">Date Closed</label>
        <input type="datetime-local" id="datumClose" name="Datum_close" class="form-control" value="@(Model?.Datum_close?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
    </div>

    <div class="mb-3">
        <label for="deadline" class="form-label">Deadline</label>
        <input type="datetime-local" id="deadline" name="Deadline" class="form-control" value="@(Model?.Deadline?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <button type="button" class="btn btn-secondary" onclick="history.back()">Back</button>
</form>