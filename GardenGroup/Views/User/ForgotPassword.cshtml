@{
    ViewData["Title"] = "Forgot Password";
}

<h1>@ViewData["Title"]</h1>

<partial name="_ConfirmMessage" />
<partial name="_ErrorMessage" />

<div class="card shadow-sm p-4 mt-3" style="max-width: 500px;">
    <p class="text-muted">
        Enter your registered email address below. If it exists in our system, we’ll send you a link to reset your password.
    </p>

    <form asp-action="ForgotPassword" method="post" class="mt-3">
        <div class="form-group mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email" name="email" class="form-control" id="email" required placeholder="Enter your email" />
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Login" class="btn btn-secondary">Back to Login</a>
            <button type="submit" class="btn btn-primary">Send Reset Link</button>
        </div>
    </form>
</div>